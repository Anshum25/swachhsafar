# Copy to backend/.env and fill in. Never commit real values.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://swachh:CHANGE_ME@127.0.0.1:5432/swachh_safar

# Firebase: only for STORAGE_BACKEND=firebase and the one-off `app.cli import-firebase-passwords`.
# Sign-in never uses it (passwords and sessions are in PostgreSQL).
FIREBASE_PROJECT_ID=swachh-safar
FIREBASE_CREDENTIALS_FILE=
FIREBASE_STORAGE_BUCKET=swachh-safar.appspot.com

# firebase | local  (local is for development only)
STORAGE_BACKEND=local
LOCAL_MEDIA_DIR=./var/media

# Long random secret used to HMAC OTP codes (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
OTP_PEPPER=CHANGE_ME

CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# disabled | http
# OTP SMS. disabled = mobile sign-in answers "unavailable" (no pretend success).
# msg91: SMS_API_KEY = MSG91 authkey, SMS_LOGIN_TEMPLATE_ID = MSG91 template id of the DLT-approved sign-in
# OTP template (sender id, DLT entity id and DLT template id are attached to it in the MSG91 panel).
# http: generic JSON gateway at SMS_API_URL (bearer SMS_API_KEY). Never commit real values.
SMS_PROVIDER=disabled
SMS_LOGIN_TEMPLATE_ID=
SMS_OTP_VARIABLE=otp
SMS_DLT_ENTITY_ID=
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=

# disabled | rapidapi
PNR_PROVIDER=disabled
PNR_API_URL=https://irctc-indian-railway-pnr-status.p.rapidapi.com/getPNRStatus/
PNR_API_HOST=irctc-indian-railway-pnr-status.p.rapidapi.com
PNR_API_KEY=

# ---- over-the-air web bundle releases (docs/OTA_UPDATES.md) ------------------------------------------
# Shared secret the CI pipeline sends as X-Release-Token to publish a web bundle and to point a channel at
# it. Must equal the RELEASE_PUBLISH_TOKEN secret in the GitHub repository. Leave it unset to close
# publishing on this server: the endpoints then answer "not configured" rather than running open.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
RELEASE_PUBLISH_TOKEN=

# Caps on what may be published. A current build is about 6 MB zipped and 11 MB unpacked; the defaults
# leave room for the face models to grow without letting a bad upload fill the phone's storage.
WEB_BUNDLE_MAX_BYTES=62914560
WEB_BUNDLE_MAX_UNPACKED_BYTES=209715200
