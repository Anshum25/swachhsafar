{
  "appId": "in.itfarmer.swachhsafar",
  "appName": "Swachh Safar",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SwachhSecurity": {},
    "SwachhFingerprint": {
      "scannerVendorId": 13561,
      "defaultTimeoutMs": 15000
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "appReadyTimeout": 20000,
      "responseTimeout": 20,
      "resetWhenUpdate": true,
      "directUpdate": false
    }
  }
}

